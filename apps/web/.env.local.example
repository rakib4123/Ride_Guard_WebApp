# Base URL of the RideGuard API. Must end in /api — the NestJS routes live
# under that prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Supabase project credentials. REQUIRED: without them the app cannot sign
# anyone in, and every visitor is redirected to a login page that will not work.
# Project → Settings → API. The anon key is public by design; all access is
# constrained by the Row-Level Security policies (see DEPLOY.md step 3).
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# CARTO basemaps key. REQUIRED for the map: without it every tile shows an
# "API KEY REQUIRED" watermark. Free for non-commercial use, emailed to you at
# https://carto.com/basemaps/apikey — restrict it to your site's domain there.
NEXT_PUBLIC_CARTO_KEY=<your-carto-key>
