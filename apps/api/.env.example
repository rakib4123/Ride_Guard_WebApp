# Port the API listens on
PORT=4000
# Comma-separated origins allowed by CORS (the web app's URL in prod)
CORS_ORIGINS=http://localhost:3000
# Where trip logs are persisted (file repository). Relative paths resolve from
# the process working directory; when unset, apps/api/data/trips.json is used
# regardless of where the process was started. Swap for a DB in prod.
# Leave this UNSET for most deployments — that is what gives the
# cwd-independent default above. Setting it to a relative path (e.g.
# ./data/trips.json) re-introduces the cwd-dependent bug this comment
# describes, so only set it to an absolute path if you need a custom location.
#TRIPS_DATA_FILE=./data/trips.json
# URL of the Python Tier-1 model sidecar (apps/model). If unset, the API uses
# the built-in transparent mock scorer instead of the real model.
MODEL_SERVICE_URL=http://localhost:8000
# How long to wait for the model service, and how many times to retry. The
# default 30s/1 retry covers a Render free-plan cold start (30-60s).
MODEL_TIMEOUT_MS=30000
MODEL_RETRIES=1

# --- Secrets: set these in production ---
# Enables the admin-only bulk trip-read endpoints (GET /api/trips[/:id]),
# which expose every rider's stored trip. Callers must send this value in an
# `x-admin-token` header. LEAVE UNSET to disable those endpoints entirely.
ADMIN_TOKEN=
# HMAC key used to pseudonymise rider ids before storage. Without it, ids are
# hashed with a known default and are reversible for emails/uuids.
# Generate with:  openssl rand -hex 32
RIDER_ID_SALT=
# Serve Swagger at /api/docs in production (off by default).
ENABLE_API_DOCS=false
